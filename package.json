{
  "name": "flightlens",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "bindings": "cargo run -p flightlens-core --bin bindings",
    "bindings:check": "cargo run -p flightlens-core --bin bindings -- --check",
    "test:ui": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts --update-snapshots",
    "screenshots:check": "playwright test --config playwright.screenshots.config.ts",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts playwright.config.ts playwright.screenshots.config.ts tests tools/screenshots.spec.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
